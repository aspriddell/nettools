<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <BlazorEnableCompression>false</BlazorEnableCompression>
    </PropertyGroup>

    <PropertyGroup>
        <InvariantTimezone>true</InvariantTimezone>
        <InvariantGlobalization>true</InvariantGlobalization>
        <SatelliteResourceLanguages>en-US</SatelliteResourceLanguages>
    </PropertyGroup>

    <PropertyGroup>
        <Title>NetTools</Title>
        <Description>A bulk traceroute/ping results visualiser powered by WebAssembly</Description>
    </PropertyGroup>

    <ItemGroup>
      <PackageReference Include="Blazor-ApexCharts" Version="6.0.0" />
      <PackageReference Include="Blazored.LocalStorage" Version="4.5.0" />
      <PackageReference Include="DragonFruit.Data" Version="4.1.2" />
      <PackageReference Include="DragonFruit.Data.Roslyn" Version="4.1.2" PrivateAssets="all" />
      <PackageReference Include="Geolocation" Version="1.2.1" />
      <PackageReference Include="Havit.Blazor.Components.Web.Bootstrap" Version="4.8.2" />
      <PackageReference Include="Humanizer.Core" Version="2.14.1" />
      <PackageReference Include="IPNetwork2" Version="3.1.764" />
      <PackageReference Include="Macross.Json.Extensions" Version="3.0.0" />
      <PackageReference Include="MathNet.Numerics" Version="5.0.0" />
      <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="9.0.5" />
      <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="9.0.5" />
      <PackageReference Include="morelinq" Version="4.4.0" />
      <PackageReference Include="Nito.AsyncEx.Coordination" Version="5.1.2" />
      <PackageReference Include="Riok.Mapperly" Version="4.2.1" />
      <PackageReference Include="Tavenem.Blazor.IndexedDB" Version="5.1.4" />
    </ItemGroup>

</Project>
